{
  "name": "alizarin-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "copy-map-worker": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/",
    "prebuild": "node scripts/generate-llms-txt.mjs && npm run copy-map-worker",
    "generate-api-docs": "node scripts/generate-api-docs.mjs",
    "build": "next build",
    "predev": "npm run copy-map-worker",
    "dev": "next dev",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "sync-docs": "rm -rf /tmp/alizarin-docs-sync && git clone --depth 1 --sparse https://github.com/flaxandteal/alizarin.git /tmp/alizarin-docs-sync && cd /tmp/alizarin-docs-sync && git sparse-checkout set docs/ && cp -r docs/* $INIT_CWD/content/docs/ && mkdir -p $INIT_CWD/public/docs/example && cp -r docs/example/* $INIT_CWD/public/docs/example/ && rm -rf /tmp/alizarin-docs-sync"
  },
  "dependencies": {
    "alizarin": "https://github.com/flaxandteal/alizarin/releases/download/v2.0.0-beta.1/alizarin-2.0.0-beta.1.tgz",
    "fumadocs-core": "15.2.13",
    "fumadocs-mdx": "11.6.2",
    "fumadocs-ui": "15.2.13",
    "maplibre-gl": "^6.6.0",
    "next": "15.3.1",
    "react": "^19.1.0",
    "react-children-utilities": "^2.10.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "eslint": "^8",
    "eslint-config-next": "15.3.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.5",
    "typedoc": "^0.27.9",
    "typedoc-plugin-markdown": "^4.4.2",
    "typescript": "^5.8.3"
  }
}
